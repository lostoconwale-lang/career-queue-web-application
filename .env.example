# Copy to .env.local and fill in. config/env.ts validates these at boot.

# MongoDB Atlas SRV string, must include a database name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/jobboard?retryWrites=true&w=majority

# JWT (token flow for mobile / non-browser clients). 32+ chars each, different.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-random-48-bytes
JWT_REFRESH_SECRET=replace-with-different-random-48-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=job-board
JWT_AUDIENCE=job-board-api

# NextAuth (web session). Generate: npx auth secret
AUTH_SECRET=replace-with-auth-secret

# Google OAuth. Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# Public base URL (browser + mobile). Must be NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 for admin image uploads (S3-compatible). Create an R2 API token
# with Object Read & Write scoped to the bucket.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=job-board-media
# S3 API endpoint — the server writes here.
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Public read URL — used to build each file's link (client + server). Must be
# NEXT_PUBLIC_. Custom domain, or r2.dev.
NEXT_PUBLIC_MEDIA_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Used only by `pnpm seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345
SEED_ADMIN_NAME=Platform Admin
SEED_ADMIN_MOBILE=9000000000
